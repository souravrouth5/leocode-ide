{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leocode.dev/schemas/runtime-manifest-v1.json",
  "title": "LeoCode runtime manifest",
  "type": "object",
  "required": ["schema", "id", "version", "versionCode", "abi", "minAndroid", "artifact", "install"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,32}$" },
    "version": { "type": "string", "minLength": 1 },
    "versionCode": { "type": "integer", "minimum": 1 },
    "abi": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["arm64-v8a", "armeabi-v7a", "x86_64"] }
    },
    "minAndroid": { "type": "integer", "minimum": 28, "maximum": 40 },
    "artifact": {
      "type": "object",
      "required": ["url", "sha256", "size"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "install": {
      "type": "object",
      "required": ["layout", "strip"],
      "additionalProperties": false,
      "properties": {
        "layout": { "enum": ["prefix", "flat"] },
        "strip": { "type": "integer", "minimum": 0 },
        "executables": { "type": "array", "items": { "type": "string" } }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "healthCheck": {
      "type": "object",
      "required": ["argv"],
      "additionalProperties": false,
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}

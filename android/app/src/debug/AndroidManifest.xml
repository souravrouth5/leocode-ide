<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Allow cleartext HTTP connections to local Vite dev server in debug builds -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">

        <!-- Phase 0 device harness. Debug builds only: it executes fixed test
             commands and must not ship in a release. -->
        <activity
            android:name=".HarnessActivity"
            android:exported="true"
            android:label="LeoCode Harness"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
